              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "summary": "Get a video by its unique URL",
        "tags": [
          "videos"
        ]
      }
    },
