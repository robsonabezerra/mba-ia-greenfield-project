    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {}
      },
      "ResendConfirmationDto": {
        "type": "object",
        "properties": {}
      },
      "LoginDto": {
        "type": "object",
        "properties": {}
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {}
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {}
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {}
      },
      "CreateVideoDto": {
        "type": "object",
        "properties": {}
      },
      "UploadSessionDto": {
        "type": "object",
        "properties": {
          "part_size": {
            "type": "number",
            "example": 67108864,
            "description": "Part size in bytes"
          },
          "part_count": {
            "type": "number",
            "example": 160,
            "description": "Number of parts to upload"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the draft expires"
          }
        },
        "required": [
          "part_size",
          "part_count",
          "expires_at"
        ]
      },
      "CreatedVideoResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string",
            "example": "dQw4w9WgXcQ",
            "description": "Unique video slug"
          },
          "title": {
            "type": "string",
            "example": "my-video"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "processing",
              "ready",
              "failed"
            ],
            "example": "draft"
          },
          "upload": {
            "$ref": "#/components/schemas/UploadSessionDto"
          }
        },
        "required": [
          "id",
          "slug",
          "title",
          "status",
          "upload"
        ]
      },
      "VideoMetadataDto": {
        "type": "object",
        "properties": {
          "width": {
            "type": "number",
            "example": 1920
          },
          "height": {
            "type": "number",
            "example": 1080
          },
          "video_codec": {
            "type": "string",
            "example": "h264"
          },
          "audio_codec": {
            "type": "string",
            "example": "aac",
            "nullable": true
          },
          "bitrate": {
            "type": "number",
            "example": 5000000,
            "nullable": true
          },
          "format_name": {
            "type": "string",
            "example": "mov,mp4,m4a,3gp,3g2,mj2"
          },
          "size_bytes": {
            "type": "number",
            "example": 104857600
          }
        },
        "required": [
          "width",
          "height",
          "video_codec",
          "audio_codec",
          "bitrate",
          "format_name",
          "size_bytes"
        ]
      },
      "VideoChannelDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nickname": {
            "type": "string",
            "example": "alice"
          },
          "name": {
            "type": "string",
            "example": "alice"
          }
        },
        "required": [
          "id",
          "nickname",
          "name"
        ]
      },
      "VideoResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string",
            "example": "dQw4w9WgXcQ"
          },
          "title": {
            "type": "string",
            "example": "My video"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "processing",
              "ready",
              "failed"
            ]
          },
          "duration_seconds": {
            "type": "number",
            "example": 212.48,
            "nullable": true
          },
          "metadata": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/VideoMetadataDto"
              }
            ]
          },
          "processing_error": {
            "type": "string",
            "nullable": true
          },
          "channel": {
            "$ref": "#/components/schemas/VideoChannelDto"
          },
          "stream_url": {
            "type": "string",
            "example": "/videos/dQw4w9WgXcQ/stream",
            "nullable": true
          },
          "download_url": {
            "type": "string",
            "example": "/videos/dQw4w9WgXcQ/download",
            "nullable": true
          },
          "thumbnail_url": {
            "type": "string",
            "example": "/videos/dQw4w9WgXcQ/thumbnail",
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "processed_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "required": [
          "id",
          "slug",
          "title",
          "status",
          "duration_seconds",
          "metadata",
          "processing_error",
          "channel",
          "stream_url",
          "download_url",
          "thumbnail_url",
          "created_at",
          "processed_at"
        ]
      },
      "SignUploadPartsDto": {
        "type": "object",
        "properties": {}
      },
      "SignedUploadPartDto": {
        "type": "object",
        "properties": {
          "part_number": {
            "type": "number",
            "example": 1
          },
          "url": {
            "type": "string",
            "description": "Presigned URL to PUT this part bytes to"
          }
        },
        "required": [
          "part_number",
          "url"
        ]
      },
      "SignedUploadPartsResponseDto": {
        "type": "object",
        "properties": {
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SignedUploadPartDto"
            }
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the URLs expire"
          }
        },
        "required": [
          "parts",
          "expires_at"
        ]
      },
      "UploadedPartDto": {
        "type": "object",
        "properties": {
          "part_number": {
            "type": "number",
            "example": 1
          },
          "size": {
            "type": "number",
            "example": 67108864,
            "description": "Bytes stored for the part"
          }
        },
        "required": [
          "part_number",
          "size"
        ]
      },
      "UploadStateResponseDto": {
        "type": "object",
        "properties": {
          "part_size": {
            "type": "number",
            "example": 67108864
          },
          "part_count": {
            "type": "number",
            "example": 160
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "uploaded_parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UploadedPartDto"
            }
          }
        },
        "required": [
          "part_size",
          "part_count",
          "expires_at",
          "uploaded_parts"
        ]
      },
      "CompletedUploadResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string",
            "example": "dQw4w9WgXcQ"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "processing",
              "ready",
              "failed"
            ],
            "example": "processing"
          }
        },
        "required": [
          "id",
          "slug",
          "status"
        ]
      },
      "ApiErrorEnvelope": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 401
          },
          "error": {
            "type": "string",
            "example": "INVALID_CREDENTIALS"
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "example": "Invalid email or password"
          },
          "code": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "statusCode",
          "error",
          "message"
        ]
      }
    }
  }
}