    "/videos/{slug}/upload/complete": {
      "post": {
        "description": "Completes the multipart upload, moves the video to processing and schedules the background processing job. Idempotent while the video is processing.",
        "operationId": "VideosController_completeUpload",
        "parameters": [
          {
            "name": "slug",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Processing scheduled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompletedUploadResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token",
